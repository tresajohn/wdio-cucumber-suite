{
  "name": "wdio-cucumber-suite",
  "version": "1.0.0",
  "description": "WebdriverIO 8 + Cucumber BDD E2E suite for automationexercise.com",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-logger.mjs",
    "test": "wdio run wdio.conf.js",
    "test:headless": "HEADLESS=true wdio run wdio.conf.js",
    "report": "npx allure generate allure-results --clean -o allure-report",
    "report:open": "npx allure open allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^9.0.0",
    "@wdio/allure-reporter": "^8.0.0",
    "@wdio/cli": "^8.0.0",
    "@wdio/cucumber-framework": "^8.0.0",
    "@wdio/local-runner": "^8.0.0",
    "@wdio/spec-reporter": "^8.0.0",
    "allure-commandline": "^2.0.0",
    "dotenv": "^16.0.0"
  }
}
